{
  "name": "replaymod-reality",
  "productName": "ReplayMod Reality",
  "version": "0.1.0",
  "description": "A non-destructive workspace for exploring and rendering location history.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "node scripts/packaging/package.cjs",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit -p config/tsconfig.json",
    "check:cache": "node tests/cache/check-cache.cjs",
    "check:annotations": "node tests/annotations/check-annotations.cjs",
    "check:annotation-labels": "node tests/annotations/check-annotation-labels.cjs",
    "check": "npm run typecheck && npm run check:storage && npm run check:cache && npm run check:annotation-labels && npm run check:backdrop",
    "check:storage": "node tests/cache/check-storage.cjs",
    "check:backdrop": "node tests/backdrop/check-backdrop.cjs"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "csv-parse": "^6.2.1",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "@xmldom/xmldom": "0.9.10"
  },
  "config": {
    "forge": "./config/forge.config.ts"
  }
}
